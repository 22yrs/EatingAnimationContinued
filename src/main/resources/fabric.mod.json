{
  "schemaVersion": 1,
  "id": "eating_animation_continued",
  "version": "${version}",
  "name": "Eating Animation Continued",
  "description": "Unofficial continuation of Eating Animation by theone_ss. Adds a sprite animation when you eat or drink something.",
  "authors": ["22yrs"],
  "contributors": ["theone_ss (original Eating Animation)", "spusik_", "PinkGoosik", "DoctorNight1"],
  "contact": {
    "sources": "https://github.com/22yrs/EatingAnimationContinued",
    "issues": "https://github.com/22yrs/EatingAnimationContinued/issues"
  },
  "license": "MIT",
  "icon": "assets/eating_animation_continued/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.yrs22.eatinganimation.EatingAnimationClient"]
  },
  "mixins": ["eating_animation_continued.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21"
  },
  "breaks": {
    "eatinganimationid": "*"
  }
